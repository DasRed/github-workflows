{
    "name": "@dasred/github-workflows",
    "version": "1.3.2",
    "type": "module",
    "author": "Marco Starker",
    "private": true,
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "bugs": {
        "url": "https://github.com/dasred/github-workflows/issues"
    },
    "homepage": "https://github.com/dasred/github-workflows",
    "engines": {
        "node": ">=26.13.0",
        "npm": ">=11.20.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dasred/github-workflows.git"
    },
    "files": [
        "*"
    ],
    "scripts": {
        "publish:check": "semantic-release --branch main --no-ci --dry-run",
        "semantic-release": "semantic-release"
    },
    "devDependencies": {
        "@saithodev/semantic-release-backmerge": "^4.0.1",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.10",
        "@semantic-release/npm": "^13.2.0",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "semantic-release": "^25.0.9"
    },
    "release": {
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            [
                "@semantic-release/npm",
                {
                    "npmPublish": false
                }
            ],
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "package-lock.json"
                    ],
                    "message": "chore(release): ${nextRelease.version} [skip ci]"
                }
            ],
            [
                "@semantic-release/github",
                {
                    "failComment": false
                }
            ],
            [
                "@semantic-release/exec",
                {
                    "successCmd": "version=${nextRelease.version}; major=$(echo \"$version\" | cut -d. -f1); minor=$(echo \"$version\" | cut -d. -f1,2); git tag -f \"v$major\" \"v$version^{commit}\" && git tag -f \"v$minor\" \"v$version^{commit}\" && git push --force origin \"refs/tags/v$major\" \"refs/tags/v$minor\""
                }
            ],
            [
                "@saithodev/semantic-release-backmerge",
                {
                    "backmergeBranches": [
                        {
                            "from": "main",
                            "to": "develop"
                        }
                    ],
                    "backmergeStrategy": "merge",
                    "mergeMode": "theirs"
                }
            ]
        ]
    }
}
